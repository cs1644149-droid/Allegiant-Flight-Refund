# Generate a long random SECRET_KEY before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite default; for PostgreSQL use postgresql+psycopg://user:password@host:5432/database
DATABASE_URL=sqlite:///applications.db
COOKIE_SECURE=0

# Gmail SMTP: use a Google App Password where eligible, not your normal Gmail password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com
ADMIN_NOTIFICATION_EMAIL=cs1644149@gmail.com

ADMIN_USERNAME=admin
# Generate with: flask --app app make-password-hash
ADMIN_PASSWORD_HASH=paste-generated-password-hash-here
